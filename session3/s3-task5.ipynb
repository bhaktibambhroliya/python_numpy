   "source": [
    "import numpy as np\n",
    "\n",
    "ratings = np.array([5, 4, 3, 4, 5, 2, 4, 5, 3, 4, 5, 3, 4, 2, 5])\n",
    "\n",
    "print(\"Original 1D Array:\", ratings)\n",
    "\n",
    "ratings_2d = ratings.reshape(3, 5)\n",
    "print(\"Reshaped 3x5 Array:\", ratings_2d)\n",
    "\n",
    "ratings_1d = ratings_2d.flatten()\n",
    "print(\"Flattened 1D Array:\", ratings_1d)"
   ]
  }
