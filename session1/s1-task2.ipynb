    "import numpy as np\n",
    "import sys\n",
    "\n",
    "my_list = list(range(1,1001))\n",
    "my_array = np.array(range(1, 1001))\n",
    "\n",
    "list_memory = sys.getsizeof(my_list)\n",
    "array_memory = my_array.nbytes\n",
    "\n",
    "print(\"memory using of list:\", list_memory, \"bytes\")\n",
    "print(\"memory using of array:\", array_memory, \"bytes\")\n"
   ]
  }
