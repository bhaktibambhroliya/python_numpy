   "source": [
    "import numpy as np\n",
    "\n",
    "paytm = np.array([1, 0, 1, 0, 1, 0])\n",
    "phonepe = np.array([0, 1, 1, 0, 0, 1])\n",
    "\n",
    "result = np.logical_or(paytm, phonepe)\n",
    "\n",
    "print(\"Paytm Payments:\", paytm)\n",
    "print(\"PhonePe Payments:\", phonepe)\n",
    "print(\"Paid by Either App:\", result)"
   ]
  }
