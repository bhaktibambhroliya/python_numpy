   "source": [
    "import numpy as np\n",
    "\n",
    "prices = np.array([250, 180, 300, 150, 200])\n",
    "\n",
    "discounts = np.array([50, 30, 60, 20, 40])\n",
    "\n",
    "final_prices = prices - discounts\n",
    "\n",
    "print(\"Original Prices:\", prices)\n",
    "print(\"Discounts:\", discounts)\n",
    "print(\"Final Prices:\", final_prices)"
   ]
  }
